    "paginacao": {"tamanho": 100, "parametro_offset": "offset", "parametro_limite": "limit"},
    "colunas": {
      "id_externo": "id",
      "nome": "nome",
      "cpf_cnpj": "cpfcnpj",
      "email": "contatos.emails.0",
      "telefone": "contatos.celulares.0",
      "logradouro": "endereco.logradouro",
      "numero": "endereco.numero",
      "bairro": "endereco.bairro",
      "cidade": "endereco.cidade",
      "uf": "endereco.uf",
      "cep": "endereco.cep",
      "situacao": "contratos.0.status",
      "plano": "contratos.0.servicos.0.plano.descricao",
      "vencimento_dia": "contratos.0.vencimento",
      "pppoe_usuario": "contratos.0.servicos.0.login",
      "pppoe_senha": "contratos.0.servicos.0.senha",
      "mac": "contratos.0.servicos.0.mac",
      "ip_fixo": "contratos.0.servicos.0.ip",
      "inicio_contrato": "contratos.0.dataCadastro"
    },
    "transformacoes": {
      "situacao": {"Ativo": "ativo", "*": "inativo"}
