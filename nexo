#!/usr/bin/env bash
# CLI de desenvolvimento do NexoISP. Node é usado somente para o frontend; API, VPN e CLI usam Go.
set -euo pipefail
cd "$(dirname "$0")"
NODE_IMG=node:22-alpine
GO_IMG=golang:1.27.2-alpine
# Ajustes só deste servidor (não versionados): ver .nexo.local.example. Ex.: Docker antigo/sem iptables, como o do PNETLab.
NEXO_COMPOSE_OVERRIDE=""; NEXO_BUILD_OPTS=""; NEXO_RUN_OPTS=""; NEXO_TOOL_NET=""
[ -f .nexo.local ] && . ./.nexo.local
COMPOSE="docker compose -p nexoisp -f infra/compose/docker-compose.yml ${NEXO_COMPOSE_OVERRIDE:+-f $NEXO_COMPOSE_OVERRIDE} --env-file .env"
nodebox() { docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e npm_config_cache=/tmp/.npm \
  --network nexoisp_default -e DATABASE_URL_OWNER -e DATABASE_URL_APP -e NEXO_AGENT_MTLS -e NEXO_DEMO_MODE -e NEXO_GATEWAY_WEBHOOK_SECRET \
  -v "$PWD":/app -w /app "$@"; }
gobox() { docker run --rm -e HOME=/tmp -e GOCACHE=/tmp/go-cache -e GOFLAGS=-mod=readonly \
  -v "$PWD":/app -v nexo-go-mod:/go/pkg/mod -v nexo-go-cache:/tmp/go-cache -w /app/apps/api-go "$GO_IMG" "$@"; }
DEMO_AGENT_ID=00000000-0000-4000-8000-0000000000a1
init_env() {  # segredos e certificados de DESENVOLVIMENTO, gerados localmente (nunca versionados)
  [ -f .env ] || cp .env.example .env
  addenv() { grep -q "^$1=" .env || echo "$1=$2" >> .env; }
  addenv NEXO_OP_SIGNING_KEY "$(openssl genpkey -algorithm ed25519 -outform DER | base64 -w0)"
  addenv NEXO_SECRET_KEY "$(openssl rand -base64 32)"
  addenv NEXO_GO_DB_PASSWORD "$(openssl rand -hex 24)"
  addenv NEXO_DEMO_AGENT_TOKEN "$(openssl rand -hex 24)"
  addenv NEXO_GATEWAY_WEBHOOK_SECRET "$(openssl rand -hex 24)"
  addenv NEXO_RADIUS_KEY "$(openssl rand -hex 24)"            # cifra as senhas PPPoE lidas pelo RADIUS integrado
  addenv NEXO_L2TP_PSK "$(openssl rand -hex 20)"              # chave IPsec do túnel L2TP/IPsec (concentradores sem WireGuard)
  addenv NEXO_RADIUS_DB_PASSWORD "$(openssl rand -hex 24)"
  addenv NEXO_REPLICA_PASSWORD "$(openssl rand -hex 24)"      # réplica do banco (perfil ha)
  addenv NEXO_UID "$(id -u):$(id -g)"
  scripts/dev-certs.sh init
  [ -f infra/certs/agent-demo/agent.crt ] || scripts/dev-certs.sh agent "$DEMO_AGENT_ID" infra/certs/agent-demo >/dev/null
  mkdir -p .data/agent-demo .data/olt-huawei-emu
}
case "${1:-help}" in
  contrato)  shift; case "${1:-}" in
               nativo) python3 tests/contrato/nativo.py ;;
               e2e) python3 tests/contrato/e2e.py ;;
               vpn) python3 tests/contrato/vpn_go.py ;;
               *) echo "uso: ./nexo contrato {nativo|e2e|vpn}"; exit 2 ;;
             esac ;;
  init)      init_env ;;
  agent-cert) scripts/dev-certs.sh agent "$2" "${3:-infra/certs/agent-$2}" ;;
  e2e)  # fumaça da interface num navegador de verdade (imagem oficial do Playwright); BASE padrão: o painel local
    docker run --rm --network host --ipc=host ${NEXO_E2E_DOCKER_OPTS:-} -v "$PWD/e2e:/e2e" -w /e2e mcr.microsoft.com/playwright:v1.49.1-jammy \
      sh -c "npm install --no-audit --no-fund --silent playwright@1.49.1 >/dev/null && BASE=${BASE:-http://localhost:18080} node smoke.mjs" ;;
  agent-test) docker build -q $NEXO_BUILD_OPTS -t nexoisp-agent services/network-agent >/dev/null && docker run --rm $NEXO_RUN_OPTS nexoisp-agent python -m unittest discover -s tests -t . ;;
  backup)    scripts/backup.sh backup "${2:-backups}" ;;
  restore-check) scripts/backup.sh restore-check "$2" ;;
  restore)   running="$($COMPOSE ps --services --filter status=running | rg '^(api|api-go|vpn|radius|radius2)$' | tr '\n' ' ' || true)"
             stop=true; start=true; if [ -n "$running" ]; then stop="$COMPOSE stop $running"; start="$COMPOSE run --rm migrate prepare && $COMPOSE start $running"; fi
             NEXO_API_SERVICE_STOP="$stop" NEXO_API_SERVICE_START="$start" scripts/backup.sh restore "$2" "${3:-}" ;;
  prod)      shift; bash scripts/prod-go.sh "$@" ;;
  lab-radius) scripts/lab-radius.sh ;;
  lab-up)    infra/lab/lab.sh up ;;
  lab-down)  infra/lab/lab.sh down ;;
  lab)       shift; infra/lab/lab.sh "$@" ;;
  trio)      shift; infra/lab-pnetlab/trio.sh "$@" ;;   # laboratório sobre o cenário do PNETLab (escreve em nós do cenário)
  homolog)   shift; infra/homolog/homolog.sh "$@" ;;
  demo-tool) shift; $COMPOSE exec agent-demo python -m nexo_agent.demo_tool "$@" ;;
  npm)       shift; if [ -n "$NEXO_TOOL_NET" ]; then docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e npm_config_cache=/tmp/.npm --network "$NEXO_TOOL_NET" -v "$PWD":/app -w /app "$NODE_IMG" npm "$@"; else nodebox "$NODE_IMG" npm "$@"; fi ;;
  sh)        shift; nodebox -it "$NODE_IMG" sh ;;
  install)   "$0" npm install ;;
  typecheck) gobox go vet ./...; nodebox "$NODE_IMG" npm -w apps/web run typecheck ;;
  build)     init_env; $COMPOSE build api migrate vpn caddy ;;
  db)        shift; $COMPOSE run --rm --build migrate "$@" ;;
  up)        init_env; $COMPOSE up -d --wait db; $COMPOSE run --rm --build migrate prepare
             if rg -q '^NEXO_DEMO_MODE=1$' .env; then $COMPOSE run --rm migrate seed-demo; fi
             $COMPOSE up -d --build ;;
  down)      $COMPOSE down ;;
  logs)      shift; $COMPOSE logs -f "$@" ;;
  ps)        $COMPOSE ps ;;
  compose)   shift; $COMPOSE "$@" ;;
  test)      gobox go test ./... ;;
  *) echo "uso: ./nexo {homolog up|preflight|down|backup|restore-check <arq>|restore <arq> --yes|lab-radius|lab-up|lab-down|lab client ...|trio up|down|status|...|init|agent-cert <id>|agent-test|demo-tool ...|install|typecheck|build|up|down|logs|ps|test|contrato {nativo|e2e|vpn}|npm ...|compose ...}" ;;
esac
