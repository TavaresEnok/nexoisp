# Módulo SQL do FreeRADIUS apontando para o SQLite local mantido pelo agente NexoISP.
sql {
	dialect = "sqlite"
	driver = "rlm_sql_${dialect}"
	sqlite {
		filename = "/data/radius/radius.sqlite"
		busy_timeout = 10000
	}
	radius_db = "radius"
	acct_table1 = "radacct"
	acct_table2 = "radacct"
	postauth_table = "radpostauth"
	authcheck_table = "radcheck"
	groupcheck_table = "radgroupcheck"
	authreply_table = "radreply"
	groupreply_table = "radgroupreply"
	usergroup_table = "radusergroup"
	client_table = "nas"
	read_groups = no
	read_clients = no
	delete_stale_sessions = yes
	pool {
		start = 1
		min = 1
		max = 4
		spare = 1
		uses = 0
		lifetime = 0
		idle_timeout = 60
		retry_delay = 1
	}
	group_attribute = "SQL-Group"
	$INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf
}
