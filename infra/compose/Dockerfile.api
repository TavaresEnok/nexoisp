FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
COPY legacy/fastify/package.json legacy/fastify/
COPY legacy/fastify/package-lock.json legacy/fastify/
COPY apps/web/package.json apps/web/
RUN npm ci && npm ci --prefix legacy/fastify --workspaces=false
COPY apps apps
COPY legacy/fastify/src legacy/fastify/src
COPY legacy/fastify/tsconfig.json legacy/fastify/tsconfig.json
RUN npm --prefix legacy/fastify --workspaces=false run build && npm -w apps/web run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json* ./
COPY legacy/fastify/package.json legacy/fastify/
COPY legacy/fastify/package-lock.json legacy/fastify/
RUN npm ci --omit=dev --prefix legacy/fastify --workspaces=false
COPY --from=build /app/legacy/fastify/dist legacy/fastify/dist
COPY --from=build /app/apps/web/dist legacy/web/dist
COPY legacy/fastify/migrations legacy/fastify/migrations
# usados só pelo serviço do túnel (mesma imagem, outro comando): WireGuard, rede e o L2TP/IPsec (strongSwan, xl2tpd, pppd)
RUN apk add --no-cache wireguard-tools-wg iproute2 strongswan xl2tpd ppp-daemon
USER node
CMD ["node", "legacy/fastify/dist/main.js"]
