FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm install
COPY apps apps
RUN npm -w apps/api run build && npm -w apps/web run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/
RUN npm install --omit=dev -w apps/api
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/web/dist apps/web/dist
COPY apps/api/migrations apps/api/migrations
# usados só pelo serviço do túnel (mesma imagem, outro comando): WireGuard, rede e o L2TP/IPsec (strongSwan, xl2tpd, pppd)
RUN apk add --no-cache wireguard-tools-wg iproute2 strongswan xl2tpd ppp-daemon
USER node
CMD ["node", "apps/api/dist/main.js"]
