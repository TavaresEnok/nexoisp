# Copie para .env (chmod 600) e gere CADA valor neste host. Nunca reutilize os valores de desenvolvimento.
NEXO_DOMAIN=painel.exemplo.com.br
POSTGRES_PASSWORD=            # openssl rand -hex 24
NEXO_APP_DB_PASSWORD=         # openssl rand -hex 24
NEXO_OP_SIGNING_KEY=          # openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
NEXO_SECRET_KEY=              # openssl rand -base64 32   (perder esta chave = perder as senhas PPPoE cifradas)
NEXO_RADIUS_KEY=              # openssl rand -hex 24   (cifra as senhas PPPoE que o RADIUS lê; perder = reprovisionar todas as contas)
NEXO_RADIUS_DB_PASSWORD=      # openssl rand -hex 24
NEXO_RADIUS_PUBLIC_HOST=      # IP ou nome pelo qual os concentradores alcançam este servidor (UDP 1812 e 1813)
# Opcionais
NEXO_ALERT_WEBHOOK_URL=       # recebe POST JSON {text, alerts} quando agentes ficam offline / operações ficam incertas
NEXO_SECRET_KEY_PREVIOUS=     # preencher só durante a rotação de NEXO_SECRET_KEY (ver docs/operacao.md)
# NEXO_HTTP_PORT=80  NEXO_HTTPS_PORT=443  NEXO_AGENT_PORT=8443
