      log_append nexo_route static
      log_append nexo_upstream caddy
      header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
      }
      header {
        match header Content-Type text/html*
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      }
      @https protocol https
      header @https Strict-Transport-Security max-age=31536000
      root * {$NEXO_WEB_ROOT:/srv}
      try_files {path} /index.html
      file_server
    }
