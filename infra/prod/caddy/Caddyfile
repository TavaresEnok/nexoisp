# Rotas HTTP nativas do backend Go.
{$NEXO_DOMAIN:localhost} {
  log {
    format json
  }
  route {
    @r0 {
      method DELETE
      path_regexp r0 ^/api/api\-tokens/[^/]+$
    }
    handle @r0 {
      log_append nexo_route "DELETE /api/api-tokens/:id"
      log_append nexo_upstream {http.reverse_proxy.upstream.address}
      reverse_proxy {$NEXO_GO_UPSTREAM:api-go:8080} {
        lb_try_duration 0
